# Database (Prisma — use Supabase Postgres connection string in production)
DATABASE_URL="postgresql://omino:omino_dev_password@localhost:5434/omino?schema=public"
# Supabase connection pooler (optional, for serverless)
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for migrations (optional)
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase — public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# New keys (recommended, 2026+)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Legacy anon key (still supported)
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Supabase — server-only (NEVER expose to browser or NEXT_PUBLIC_*)
SUPABASE_SECRET_KEY="sb_secret_..."
# Legacy service role key (still supported)
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# JWT secret from Supabase Dashboard → Settings → API → JWT Secret
# Used to sign realtime tokens for NextAuth sessions
SUPABASE_JWT_SECRET=""

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# App
NODE_ENV="development"

# Platform operators (comma-separated emails) — server-side
PLATFORM_ADMIN_EMAILS=""

# AI (Phase 8) — server-side only, never expose to browser
AI_ENABLED="true"
AI_PROVIDER="mock"
# AI_PROVIDER="gemini"
# AI_PROVIDER="openai"
# GEMINI_API_KEY=""
# OPENAI_API_KEY="sk-..."
AI_MODEL="gemini-2.5-flash"
# AI_DEEP_MODEL="gemini-2.5-pro"
AI_TEMPERATURE="0.3"
AI_MAX_TOKENS="2048"
AI_MAX_TOOL_ITERATIONS="6"
AI_MAX_MESSAGES_IN_CONTEXT="20"
AI_RATE_LIMIT_PER_MINUTE="30"

# Automation cron (optional) — protect /api/automations/process
# Required in production
# AUTOMATION_CRON_SECRET="change-me"

# Rate limits
SIGNUP_RATE_LIMIT_PER_HOUR="10"
AUTOMATION_EXEC_RATE_LIMIT_PER_MINUTE="60"
