generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth) ───────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?   @map("password_hash")
  fullName      String?   @map("full_name")
  phone         String?
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  context     UserContext?
  stockMovements StockMovement[]
  stockTransfers StockTransfer[]
  posSessions    PosSession[]
  carts          Cart[]
  orders         Order[]
  payments       Payment[]
  refunds        Refund[]
  orderEvents    OrderEvent[]
  auditLogs      AuditLog[]
  cancelledOrders Order[] @relation("OrderCancelledBy")
  customerNotes  CustomerNote[]
  customerEvents CustomerEvent[]
  aiConversations AiConversation[]
  aiActions       AiAction[]
  aiMemories        AiMemory[]
  aiUsage           AiUsage[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Multi-tenancy core ────────────────────────────────────────────

model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  businessType String?  @map("business_type")
  country      String?
  currency     String   @default("USD")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  roles       Role[]
  stores      Store[]
  categories  Category[]
  productOptions ProductOption[]
  products    Product[]
  productVariants ProductVariant[]
  stockLocations StockLocation[]
  stockLevels StockLevel[]
  stockMovements StockMovement[]
  stockTransfers StockTransfer[]
  registers      Register[]
  posSessions    PosSession[]
  customers      Customer[]
  carts          Cart[]
  orders         Order[]
  payments       Payment[]
  refunds        Refund[]
  orderEvents    OrderEvent[]
  auditLogs      AuditLog[]
  orderNumberSequences OrderNumberSequence[]
  customerTags         CustomerTag[]
  customerNotes        CustomerNote[]
  customerEvents       CustomerEvent[]
  customerAddresses    CustomerAddress[]
  aiConversations      AiConversation[]
  aiActions            AiAction[]
  aiMemories           AiMemory[]
  aiUsage              AiUsage[]
  automations          Automation[]
  businessEvents       BusinessEvent[]
  automationExecutions AutomationExecution[]
  automationScheduledJobs AutomationScheduledJob[]
  internalNotifications InternalNotification[]
  marketingAudiences   MarketingAudience[]
  marketingPromotions  MarketingPromotion[]
  marketingCampaigns   MarketingCampaign[]
  marketingConversions MarketingConversion[]
  marketingPromotionRedemptions MarketingPromotionRedemption[]
  marketingCampaignEvents MarketingCampaignEvent[]
  collections          Collection[]
  storefrontEvents     StorefrontEvent[]
  storefrontDailyMetrics StorefrontDailyMetric[]
  searchQueryLogs      SearchQueryLog[]
  productAffinities    ProductAffinity[]
  storefrontAccounts   StorefrontAccount[]
  storeDomains         StoreDomain[]
  productReviews       ProductReview[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  slug           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  permissions  RolePermission[]

  @@unique([organizationId, slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  module      String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Store {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String
  slug           String
  publicSlug     String      @unique @map("public_slug")
  isDefault      Boolean     @default(false) @map("is_default")
  status         StoreStatus @default(ACTIVE)
  description    String?     @db.Text
  logoUrl        String?     @map("logo_url")
  faviconUrl     String?     @map("favicon_url")
  contactEmail   String?     @map("contact_email")
  contactPhone   String?     @map("contact_phone")
  currency       String?
  country        String?
  timezone       String?     @default("UTC")
  primaryColor   String?     @map("primary_color")
  secondaryColor String?     @map("secondary_color")
  socialLinks    Json?       @map("social_links")
  taxRateBps     Int         @default(0) @map("tax_rate_bps")
  checkoutSettings Json?     @map("checkout_settings")
  themeSettings    Json?     @map("theme_settings")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches     Branch[]
  categories   Category[]
  products     Product[]
  stockLocations StockLocation[]
  registers    Register[]
  posSessions  PosSession[]
  carts        Cart[]
  orders       Order[]
  payments     Payment[]
  shippingMethods ShippingMethod[]
  marketingAudiences MarketingAudience[]
  marketingPromotions MarketingPromotion[]
  marketingCampaigns MarketingCampaign[]
  collections      Collection[]
  storefrontEvents StorefrontEvent[]
  storefrontDailyMetrics StorefrontDailyMetric[]
  searchQueryLogs  SearchQueryLog[]
  storefrontAccounts StorefrontAccount[]
  storeDomains     StoreDomain[]
  productReviews   ProductReview[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("stores")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  name      String
  slug      String
  isDefault Boolean  @default(false) @map("is_default")
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stockLocations StockLocation[]
  registers      Register[]
  posSessions    PosSession[]
  carts          Cart[]
  orders         Order[]
  payments       Payment[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("branches")
}

model ShippingMethod {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  name            String
  slug            String
  description     String?
  priceMinor      Int      @default(0) @map("price_minor")
  estimatedDelivery String? @map("estimated_delivery")
  isActive        Boolean  @default(true) @map("is_active")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([organizationId])
  @@map("shipping_methods")
}

model UserContext {
  userId         String  @id @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  storeId        String? @map("store_id") @db.Uuid
  branchId       String? @map("branch_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_contexts")
}

// ─── Catalog & inventory (Phase 2) ─────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
}

enum ProductCatalogKind {
  SIMPLE
  BUNDLE
}

enum BarcodeType {
  EAN
  UPC
  GTIN
  INTERNAL
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  INITIAL
  RESERVATION
  RELEASE
}

enum StockTransferStatus {
  DRAFT
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum StockLocationType {
  BRANCH
  WAREHOUSE
  BACKROOM
  OTHER
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  storeId        String?   @map("store_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String
  slug           String
  description    String?
  imageUrl       String?   @map("image_url")
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]   @relation("CategoryTree")
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([parentId])
  @@map("categories")
}

model ProductOption {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       ProductOptionValue[]
  products     ProductOptionLink[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(uuid()) @db.Uuid
  optionId String @map("option_id") @db.Uuid
  value    String
  position Int    @default(0)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantOption[]

  @@unique([optionId, value])
  @@index([optionId])
  @@map("product_option_values")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  storeId        String?       @map("store_id") @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  name           String
  slug           String
  description    String?       @db.Text
  status         ProductStatus @default(DRAFT)
  productType    ProductType        @default(PHYSICAL) @map("product_type")
  catalogKind    ProductCatalogKind @default(SIMPLE) @map("catalog_kind")
  isFeatured     Boolean            @default(false) @map("is_featured")
  brand          String?
  hasVariants    Boolean       @default(false) @map("has_variants")
  trackInventory Boolean       @default(true) @map("track_inventory")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store?              @relation(fields: [storeId], references: [id], onDelete: SetNull)
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  images       ProductImage[]
  options      ProductOptionLink[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  bundleItems  BundleItem[]        @relation("BundleParent")
  includedInBundles BundleItem[]   @relation("BundleChild")
  collectionProducts CollectionProduct[]
  reviews      ProductReview[]
  affinitiesA  ProductAffinity[]   @relation("AffinityA")
  affinitiesB  ProductAffinity[]   @relation("AffinityB")

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([storeId])
  @@index([categoryId])
  @@map("products")
}

model BundleItem {
  id                String @id @default(uuid()) @db.Uuid
  bundleProductId   String @map("bundle_product_id") @db.Uuid
  includedProductId String @map("included_product_id") @db.Uuid
  quantity          Int    @default(1)
  position          Int    @default(0)

  bundleProduct   Product @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  includedProduct Product @relation("BundleChild", fields: [includedProductId], references: [id], onDelete: Restrict)

  @@unique([bundleProductId, includedProductId])
  @@index([bundleProductId])
  @@map("bundle_items")
}

model ProductOptionLink {
  productId String @map("product_id") @db.Uuid
  optionId  String @map("option_id") @db.Uuid
  position  Int    @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  option  ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([productId, optionId])
  @@map("product_option_links")
}

model ProductVariant {
  id                String        @id @default(uuid()) @db.Uuid
  productId         String        @map("product_id") @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  sku               String
  barcode           String?
  barcodeType       BarcodeType?  @map("barcode_type")
  name              String?
  costPrice         Int?          @map("cost_price")
  sellingPrice      Int           @map("selling_price")
  compareAtPrice    Int?          @map("compare_at_price")
  currency          String        @default("USD")
  weightGrams       Int?          @map("weight_grams")
  trackInventory    Boolean       @default(true) @map("track_inventory")
  lowStockThreshold Int?          @map("low_stock_threshold")
  reorderPoint      Int?          @map("reorder_point")
  status            ProductStatus @default(ACTIVE)
  position          Int           @default(0)
  isDefault         Boolean       @default(false) @map("is_default")
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  images        ProductImage[]
  optionValues  ProductVariantOption[]
  stockLevels   StockLevel[]
  stockMovements StockMovement[]
  transferItems StockTransferItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@unique([organizationId, sku])
  @@index([productId])
  @@index([organizationId])
  @@index([barcode])
  @@map("product_variants")
}

model ProductVariantOption {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("product_variant_options")
}

model ProductImage {
  id             String  @id @default(uuid()) @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  variantId      String? @map("variant_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  url            String
  altText        String? @map("alt_text")
  position       Int     @default(0)
  isPrimary      Boolean @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([organizationId])
  @@map("product_images")
}

model StockLocation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  storeId        String            @map("store_id") @db.Uuid
  branchId       String?           @map("branch_id") @db.Uuid
  name           String
  slug           String
  type           StockLocationType @default(BRANCH)
  isDefault      Boolean           @default(false) @map("is_default")
  address        String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  stockLevels    StockLevel[]
  movements      StockMovement[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([storeId])
  @@index([branchId])
  @@map("stock_locations")
}

model StockLevel {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  stockLocationId   String   @map("stock_location_id") @db.Uuid
  quantityOnHand    Int      @default(0) @map("quantity_on_hand")
  quantityReserved  Int      @default(0) @map("quantity_reserved")
  quantityIncoming  Int      @default(0) @map("quantity_incoming")
  lowStockThreshold Int?     @map("low_stock_threshold")
  reorderPoint      Int?     @map("reorder_point")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockLocation StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)

  @@unique([variantId, stockLocationId])
  @@index([organizationId])
  @@index([stockLocationId])
  @@map("stock_levels")
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  variantId       String            @map("variant_id") @db.Uuid
  stockLocationId String            @map("stock_location_id") @db.Uuid
  userId          String?           @map("user_id") @db.Uuid
  type            StockMovementType
  quantity        Int
  balanceAfter    Int               @map("balance_after")
  reason          String?
  referenceType   String?           @map("reference_type")
  referenceId     String?           @map("reference_id")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockLocation StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([variantId])
  @@index([stockLocationId])
  @@map("stock_movements")
}

model StockTransfer {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  fromLocationId String              @map("from_location_id") @db.Uuid
  toLocationId   String              @map("to_location_id") @db.Uuid
  status         StockTransferStatus @default(DRAFT)
  notes          String?
  createdById    String              @map("created_by_id") @db.Uuid
  completedAt    DateTime?           @map("completed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromLocation StockLocation       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   StockLocation       @relation("TransferTo", fields: [toLocationId], references: [id])
  createdBy    User                @relation(fields: [createdById], references: [id])
  items        StockTransferItem[]

  @@index([organizationId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String @id @default(uuid()) @db.Uuid
  transferId       String @map("transfer_id") @db.Uuid
  variantId        String @map("variant_id") @db.Uuid
  quantity         Int
  quantityReceived Int    @default(0) @map("quantity_received")

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("stock_transfer_items")
}

// ─── POS, Orders, Payments (Phase 3–4) ───────────────────────────

enum PosSessionStatus {
  OPEN
  CLOSED
}

enum CartStatus {
  ACTIVE
  HELD
  COMPLETED
  CANCELLED
}

enum CartChannel {
  POS
  ONLINE
}

enum StoreStatus {
  ACTIVE
  PAUSED
  MAINTENANCE
}

enum OrderSource {
  POS
  ONLINE
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
  COD
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PromotionKind {
  PERCENT_OFF
  FIXED_OFF
  FREE_SHIPPING
}

enum AdjustmentType {
  DISCOUNT
  TAX
  SHIPPING
  FEE
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CustomerSource {
  POS
  ONLINE_STORE
  MANUAL
  IMPORT
  API
}

enum CustomerAddressType {
  SHIPPING
  BILLING
  OTHER
}

model Register {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  name           String
  slug           String
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sessions     PosSession[]
  carts        Cart[]
  orders       Order[]

  @@unique([branchId, slug])
  @@index([organizationId])
  @@map("registers")
}

model PosSession {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  storeId        String           @map("store_id") @db.Uuid
  branchId       String           @map("branch_id") @db.Uuid
  registerId     String           @map("register_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         PosSessionStatus @default(OPEN)
  openingCash    Int              @default(0) @map("opening_cash")
  closingCash    Int?             @map("closing_cash")
  expectedCash   Int?             @map("expected_cash")
  cashDifference Int?             @map("cash_difference")
  cashSales      Int              @default(0) @map("cash_sales")
  cardSales      Int              @default(0) @map("card_sales")
  otherSales     Int              @default(0) @map("other_sales")
