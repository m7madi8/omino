// ─── Automation (Phase 9) ──────────────────────────────────────────

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

enum AutomationStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

model BusinessEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  storeId        String?  @map("store_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  type           String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  source         String   @default("domain")
  payload        Json
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]

  @@index([organizationId, type, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("business_events")
}

model Automation {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  storeId          String?          @map("store_id") @db.Uuid
  branchId         String?          @map("branch_id") @db.Uuid
  name             String
  description      String?
  status           AutomationStatus @default(DRAFT)
  currentVersionId String?          @unique @map("current_version_id") @db.Uuid
  createdById      String?          @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentVersion AutomationVersion?        @relation("AutomationCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       AutomationVersion[]       @relation("AutomationVersions")
  executions     AutomationExecution[]
  scheduledJobs  AutomationScheduledJob[]

  @@index([organizationId, status])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("automations")
}

model AutomationVersion {
  id            String   @id @default(uuid()) @db.Uuid
  automationId  String   @map("automation_id") @db.Uuid
  versionNumber Int      @map("version_number")
  triggerType   String   @map("trigger_type")
  config        Json
  createdAt     DateTime @default(now()) @map("created_at")

  automation         Automation            @relation("AutomationVersions", fields: [automationId], references: [id], onDelete: Cascade)
  automationCurrent  Automation?           @relation("AutomationCurrentVersion")
  executions         AutomationExecution[]
  scheduledJobs      AutomationScheduledJob[]

  @@unique([automationId, versionNumber])
  @@map("automation_versions")
}

model AutomationExecution {
  id              String                    @id @default(uuid()) @db.Uuid
  organizationId  String                    @map("organization_id") @db.Uuid
  automationId    String                    @map("automation_id") @db.Uuid
  versionId       String                    @map("version_id") @db.Uuid
  businessEventId String?                   @map("business_event_id") @db.Uuid
  eventType       String?                   @map("event_type")
  idempotencyKey  String                    @map("idempotency_key")
  status          AutomationExecutionStatus @default(PENDING)
  conditionResult Json?                     @map("condition_result")
  eventSnapshot   Json?                     @map("event_snapshot")
  error           String?
  startedAt       DateTime                  @default(now()) @map("started_at")
  completedAt     DateTime?                 @map("completed_at")
  durationMs      Int?                      @map("duration_ms")

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automation    Automation                @relation(fields: [automationId], references: [id], onDelete: Cascade)
  version       AutomationVersion         @relation(fields: [versionId], references: [id])
  businessEvent BusinessEvent?            @relation(fields: [businessEventId], references: [id], onDelete: SetNull)
  steps         AutomationExecutionStep[]
  scheduledJobs AutomationScheduledJob[]

  @@unique([organizationId, idempotencyKey])
  @@index([automationId, startedAt(sort: Desc)])
  @@index([organizationId, status, startedAt(sort: Desc)])
  @@map("automation_executions")
}

model AutomationExecutionStep {
  id           String               @id @default(uuid()) @db.Uuid
  executionId  String               @map("execution_id") @db.Uuid
  stepIndex    Int                  @map("step_index")
  stepType     String               @map("step_type")
  actionType   String?              @map("action_type")
  input        Json?
  output       Json?
  status       AutomationStepStatus @default(PENDING)
  attemptCount Int                  @default(0) @map("attempt_count")
  maxAttempts  Int                  @default(3) @map("max_attempts")
  nextRetryAt  DateTime?            @map("next_retry_at")
  error        String?
  startedAt    DateTime?            @map("started_at")
  completedAt  DateTime?            @map("completed_at")

  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, stepIndex])
  @@index([status, nextRetryAt])
  @@map("automation_execution_steps")
}

model AutomationScheduledJob {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  automationId   String   @map("automation_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  executionId    String?  @map("execution_id") @db.Uuid
  stepIndex      Int?     @map("step_index")
  jobType        String   @map("job_type")
  runAt          DateTime @map("run_at")
  status         String   @default("pending")
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")
  processedAt    DateTime? @map("processed_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automation   Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  version      AutomationVersion     @relation(fields: [versionId], references: [id])
  execution    AutomationExecution?  @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([organizationId, status])
  @@map("automation_scheduled_jobs")
}

model InternalNotification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  title          String
  body           String    @db.Text
  metadata       Json?
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, userId, readAt])
  @@map("internal_notifications")
}

