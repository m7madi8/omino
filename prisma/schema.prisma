model Order {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  storeId           String            @map("store_id") @db.Uuid
  branchId          String            @map("branch_id") @db.Uuid
  registerId        String?           @map("register_id") @db.Uuid
  posSessionId      String?           @map("pos_session_id") @db.Uuid
  cartId            String?           @unique @map("cart_id") @db.Uuid
  userId            String?           @map("user_id") @db.Uuid
  customerId        String?           @map("customer_id") @db.Uuid
  orderNumber       String            @map("order_number")
  source            OrderSource       @default(POS)
  status            OrderStatus       @default(DRAFT)
  paymentStatus     PaymentStatus     @default(PENDING) @map("payment_status")
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  currency          String            @default("USD")
  subtotalMinor     Int               @map("subtotal_minor")
  discountType      DiscountType?     @map("discount_type")
  discountValue     Int?              @map("discount_value")
  discountAmount    Int               @default(0) @map("discount_amount")
  taxRateBps        Int               @default(0) @map("tax_rate_bps")
  taxAmount         Int               @default(0) @map("tax_amount")
  shippingAmount    Int               @default(0) @map("shipping_amount")
  feesAmount        Int               @default(0) @map("fees_amount")
  totalMinor        Int               @map("total_minor")
  paidMinor         Int               @default(0) @map("paid_minor")
  refundedMinor     Int               @default(0) @map("refunded_minor")
  customerName      String?           @map("customer_name")
  guestEmail        String?           @map("guest_email")
  guestPhone        String?           @map("guest_phone")
  shippingAddress   Json?             @map("shipping_address")
  accessToken       String?           @unique @map("access_token")
  notes             String?
  metadata          Json?
  couponCode        String?           @map("coupon_code")
  promotionId       String?           @map("promotion_id") @db.Uuid
  campaignId        String?           @map("campaign_id") @db.Uuid
  idempotencyKey    String?           @unique @map("idempotency_key")
  completedAt       DateTime?         @map("completed_at")
  cancelledAt       DateTime?         @map("cancelled_at")
  cancelledById     String?           @map("cancelled_by_id") @db.Uuid
  cancelReason      String?           @map("cancel_reason")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  register     Register?        @relation(fields: [registerId], references: [id], onDelete: SetNull)
  posSession   PosSession?      @relation(fields: [posSessionId], references: [id], onDelete: SetNull)
  cart         Cart?            @relation(fields: [cartId], references: [id], onDelete: SetNull)
  user         User?            @relation(fields: [userId], references: [id])
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cancelledBy  User?            @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  promotion    MarketingPromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  campaign     MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]
  adjustments  OrderAdjustment[]
  refunds      Refund[]
  events       OrderEvent[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, source])
  @@map("orders")
}

